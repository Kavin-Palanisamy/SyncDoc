# SyncDoc Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration
# In production (NODE_ENV=production), MONGODB_URI is strictly REQUIRED.
# In development or test mode, if left empty, an in-memory MongoDB server starts automatically.
MONGODB_URI=mongodb://localhost:27017/syncdoc

# WebSocket Configuration
# Shares port with HTTP server in unified architecture; can be used as fallback to PORT
WEBSOCKET_PORT=5000

# Request Body Limit
# Maximum allowed payload size for JSON request bodies (e.g. large AST trees or Markdown imports)
BODY_LIMIT=10mb

# Google OAuth 2.0 Authentication Configuration
# Obtain your OAuth Client ID from Google Cloud Console (APIs & Services > Credentials).
# Authorized JavaScript Origins: http://localhost:5173, http://127.0.0.1:5173
# Authorized redirect URIs: http://localhost:5173
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Session Security Configuration
# Secret key used to sign application JWT session tokens
JWT_SECRET=syncdoc-super-secure-jwt-session-secret-change-in-production-2026
